# ---- Server ----
NODE_ENV=development
PORT=5000
# Public URL users type in the browser (used in e-mailed password links and CORS).
APP_URL=http://localhost:5173
# Comma-separated list of allowed browser origins (same as APP_URL unless you have several).
FRONTEND_ORIGIN=http://localhost:5173
# Set to 1 when running behind nginx / a load balancer / Render / Railway (needed for correct client IPs).
TRUST_PROXY=0
# Serve the built frontend (frontend/dist) from this server. Recommended for production (single origin).
SERVE_FRONTEND=false

# ---- Database (use a dedicated least-privilege user in production, NOT root) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=hostelbuddy_app
DB_PASSWORD=change_me
DB_NAME=hostelbuddy
DB_SSL=false
# For managed MySQL that requires TLS (e.g. Aiven): DB_SSL=true and provide its CA certificate (file path, PEM text, or base64)
DB_SSL_CA=
DB_SSL_CA_BASE64=
# Last resort only (encrypted but NOT verified): DB_SSL_INSECURE=true
DB_SSL_INSECURE=false
# Only used by `npm run db:migrate` / seed scripts (needs CREATE/ALTER/INDEX). Falls back to DB_USER/DB_PASSWORD.
MIGRATE_DB_USER=
MIGRATE_DB_PASSWORD=

# ---- Security ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Cookie is Secure (HTTPS only) automatically when NODE_ENV=production. Override only for plain-HTTP testing.
COOKIE_SECURE=

# ---- Optional SMTP (college mail server) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HostelBuddy <noreply@yourcollege.edu>
# strict (default, same-site deployment) | lax | none (frontend and API on different sites; needs HTTPS)
COOKIE_SAMESITE=strict
# Background job that flags overdue outpasses. Set false on all but one instance if you scale horizontally.
RUN_JOBS=true
